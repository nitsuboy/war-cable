{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5000",
  "Guard": {
    "TurnSeconds": 20,
    "ReconnectGraceSeconds": 30,
    "MaxConnectionsPerIp": 5,
    "MaxMessagesPerSecond": 20,
    "MaxRoomsPerIp": 3,
    "MaxViolationsBeforeCooldown": 5,
    "CooldownSeconds": 30,
    "WaitingRoomIdleMinutes": 10,
    "FinishedRoomIdleSeconds": 120
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "https://html-classic.itch.zone",
      "https://itch.zone"
    ]
  }
}
