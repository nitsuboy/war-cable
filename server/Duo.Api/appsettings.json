{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Guard": {
    "TurnSeconds": 20,
    "ReconnectGraceSeconds": 30,
    "MaxConnectionsPerIp": 5,
    "MaxMessagesPerSecond": 20,
    "MaxRoomsPerIp": 3,
    "MaxViolationsBeforeCooldown": 5,
    "CooldownSeconds": 30,
    "WaitingRoomIdleMinutes": 10,
    "FinishedRoomIdleSeconds": 120
  },
  "Auth": {
    "PasswordIterations": 600000,
    "SessionDays": 30,
    "MinUsernameLength": 3,
    "MaxUsernameLength": 20,
    "MinPasswordLength": 8,
    "MaxPasswordLength": 128,
    "MaxAttemptsPerIp": 10,
    "MaxAttemptsPerUsername": 5,
    "AttemptWindowSeconds": 300,
    "BlockSeconds": 300,
    "MaxRegistrationsPerHour": 10
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173",
      "http://127.0.0.1:4173",
      "https://html-classic.itch.zone",
      "https://itch.zone",
      "https://nitsuboy.github.io"
    ]
  }
}
